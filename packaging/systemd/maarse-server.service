# systemd unit for maarse-server (a backbone node without radio).
#
# Install:
#   sudo install -m 0755 target/release/maarse-server /usr/local/bin/maarse-server
#   sudo install -m 0644 packaging/systemd/maarse-server.service /etc/systemd/system/
#   sudo install -d -m 0700 /var/lib/maarse-server
#   echo '--public-addr backbone.example.org:4242' | sudo tee /var/lib/maarse-server/settings.txt
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now maarse-server
#
# All settings are in settings.txt in the data folder, one option per line as on the
# command line (maarse-server --help). The dashboard's Settings tab edits the same
# file. The service itself takes no options. scripts/install-server.sh does all of
# this and more.
#
# Open TCP port 4242 in the firewall (e.g. sudo ufw allow 4242/tcp).
# Status lines every 10 minutes: journalctl -u maarse-server -f

[Unit]
Description=Maarse backbone node
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/maarse-server --service --data /var/lib/maarse-server
Restart=on-failure
RestartSec=3
StartLimitIntervalSec=0

DynamicUser=yes
StateDirectory=maarse-server maarse-server-state
StateDirectoryMode=0700
# Outside the data folder, so that restoring a backup of the data folder is
# noticed and old encryption sessions are not used again.
Environment=MAARSE_STATE_DIR=/var/lib/maarse-server-state
WorkingDirectory=/var/lib/maarse-server

# Hardening: no devices are needed.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
